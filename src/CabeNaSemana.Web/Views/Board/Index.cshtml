@model BoardPageViewModel
@{
    ViewData["Title"] = "Seu quadro";
    var capacity = Model.Board.Capacity;
    var progressWidth = Math.Min(capacity.UsagePercentage, 100m).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
    var completionRate = Model.Board.TotalTasks == 0
        ? 0
        : (int)Math.Round(Model.Board.CompletedTasks * 100d / Model.Board.TotalTasks);
    bool HasErrors(string field) =>
        ViewData.ModelState.TryGetValue(field, out var entry) && entry.Errors.Count > 0;
}

<main id="main-content" class="page-shell" tabindex="-1">
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="flash flash-success" role="status" aria-live="polite">
            <span aria-hidden="true">✓</span> @successMessage
        </div>
    }
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="flash flash-error" role="alert">
            <span aria-hidden="true">!</span> @errorMessage
        </div>
    }

    <section class="dashboard-head" aria-labelledby="page-title">
        <div class="title-block">
            <p class="eyebrow">Semana em perspectiva</p>
            <h1 id="page-title">O que realmente cabe?</h1>
            <p>Priorize pelo que importa, reconheça os limites e ajuste o plano antes que a semana ajuste você.</p>
        </div>

        <section class="capacity-panel @(capacity.IsOverloaded ? "is-overloaded" : string.Empty)" aria-labelledby="capacity-title">
            <div class="capacity-heading">
                <div>
                    <span class="section-kicker">Capacidade semanal</span>
                    <h2 id="capacity-title">
                        <strong>@capacity.UsedHours.ToString("0.#") h</strong>
                        <span>de @capacity.WeeklyHours.ToString("0.#") h usadas</span>
                    </h2>
                </div>
                <span class="capacity-percent">@capacity.UsagePercentage.ToString("0.#")%</span>
            </div>
            <div
                class="capacity-track"
                role="progressbar"
                aria-label="Capacidade semanal usada"
                aria-valuemin="0"
                aria-valuemax="@capacity.WeeklyHours"
                aria-valuenow="@capacity.UsedHours">
                <span style="--capacity-width: @progressWidth%"></span>
            </div>
            <div class="capacity-foot">
                @if (capacity.IsOverloaded)
                {
                    <span class="capacity-warning"><span aria-hidden="true">▲</span> Excesso de @capacity.OverbookedHours.ToString("0.#") h</span>
                }
                else
                {
                    <span><span aria-hidden="true">○</span> @capacity.AvailableHours.ToString("0.#") h ainda disponíveis</span>
                }
                <form asp-action="SetCapacity" method="post" class="capacity-form">
                    <label for="WeeklyCapacity">Ajustar</label>
                    <input id="WeeklyCapacity" name="WeeklyCapacity" type="number" min="1" max="80" step="0.5" value="@capacity.WeeklyHours" aria-label="Capacidade semanal em horas" />
                    <button type="submit">Salvar</button>
                </form>
            </div>
        </section>
    </section>

    @if (capacity.IsOverloaded)
    {
        <section class="overload-alert" role="alert" aria-labelledby="overload-title">
            <span class="alert-icon" aria-hidden="true">↯</span>
            <div>
                <h2 id="overload-title">A conta não fecha ainda</h2>
                <p>As atividades desta semana somam <strong>@capacity.UsedHours.ToString("0.#") h</strong>. Mova, reduza ou conclua <strong>@capacity.OverbookedHours.ToString("0.#") h</strong> para voltar ao limite.</p>
            </div>
        </section>
    }

    <section class="workbench" aria-label="Planejamento da semana">
        <aside class="quick-add" aria-labelledby="quick-add-title">
            <div class="quick-add-head">
                <span class="step-number" aria-hidden="true">+</span>
                <div>
                    <p class="eyebrow">Captura rápida</p>
                    <h2 id="quick-add-title">Nova atividade</h2>
                </div>
            </div>
            <form asp-action="Create" method="post" class="task-form" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert" tabindex="-1"></div>

                <div class="field field-wide">
                    <label asp-for="NewTask.Title"></label>
                    <input asp-for="NewTask.Title" placeholder="Ex.: estudar capítulo 4" aria-describedby="new-task-title-error" aria-invalid="@(HasErrors("NewTask.Title").ToString().ToLowerInvariant())" />
                    <span asp-validation-for="NewTask.Title" id="new-task-title-error" class="field-error" role="alert"></span>
                </div>

                <div class="field">
                    <label asp-for="NewTask.DueDate"></label>
                    <input asp-for="NewTask.DueDate" type="date" aria-describedby="new-task-date-error" aria-invalid="@(HasErrors("NewTask.DueDate").ToString().ToLowerInvariant())" />
                    <span asp-validation-for="NewTask.DueDate" id="new-task-date-error" class="field-error" role="alert"></span>
                </div>

                <div class="field">
                    <label asp-for="NewTask.Importance"></label>
                    <select asp-for="NewTask.Importance" aria-describedby="new-task-importance-error" aria-invalid="@(HasErrors("NewTask.Importance").ToString().ToLowerInvariant())">
                        <option value="Low">Baixa</option>
                        <option value="Medium">Média</option>
                        <option value="High">Alta</option>
                        <option value="Critical">Crítica</option>
                    </select>
                    <span asp-validation-for="NewTask.Importance" id="new-task-importance-error" class="field-error" role="alert"></span>
                </div>

                <div class="field">
                    <label asp-for="NewTask.EstimatedHours"></label>
                    <div class="input-suffix">
                        <input asp-for="NewTask.EstimatedHours" type="number" min="0.25" max="100" step="0.25" aria-describedby="effort-hint new-task-effort-error" aria-invalid="@(HasErrors("NewTask.EstimatedHours").ToString().ToLowerInvariant())" />
                        <span aria-hidden="true">h</span>
                    </div>
                    <small id="effort-hint">Tempo de foco realista.</small>
                    <span asp-validation-for="NewTask.EstimatedHours" id="new-task-effort-error" class="field-error" role="alert"></span>
                </div>

                <div class="field">
                    <label asp-for="NewTask.Status"></label>
                    <select asp-for="NewTask.Status" aria-invalid="@(HasErrors("NewTask.Status").ToString().ToLowerInvariant())">
                        <option value="Planning">A planejar</option>
                        <option value="ThisWeek">Esta semana</option>
                        <option value="InProgress">Em andamento</option>
                        <option value="Completed">Concluído</option>
                    </select>
                    <span asp-validation-for="NewTask.Status" class="field-error" role="alert"></span>
                </div>

                <button class="primary-button field-wide" type="submit">
                    Adicionar ao quadro <span aria-hidden="true">→</span>
                </button>
            </form>
        </aside>

        <section class="week-glance" aria-labelledby="glance-title">
            <div>
                <p class="eyebrow">Resumo visual</p>
                <h2 id="glance-title">Ritmo da semana</h2>
            </div>
            <div class="glance-grid">
                <div><strong>@Model.Board.TotalTasks</strong><span>atividades</span></div>
                <div><strong>@Model.Board.CompletedTasks</strong><span>concluídas</span></div>
                <div><strong>@completionRate%</strong><span>do quadro</span></div>
            </div>
            <p class="glance-note">A prioridade combina importância, proximidade do prazo e tamanho do esforço. Ela orienta; você continua no comando.</p>
        </section>
    </section>

    <section class="board-section" aria-labelledby="board-title">
        <div class="board-heading">
            <div>
                <p class="eyebrow">Plano revisável</p>
                <h2 id="board-title">Quadro da semana</h2>
            </div>
            <p>Mova cada cartão pelo menu “Mover”. Funciona com teclado, toque ou mouse.</p>
        </div>

        <div class="kanban-board">
            @foreach (var column in Model.Board.Columns)
            {
                var columnToken = UiLabels.CssToken(column.Status);
                <section class="kanban-column column-@columnToken" aria-labelledby="column-@columnToken-title">
                    <header class="column-head">
                        <div>
                            <h3 id="column-@columnToken-title">@UiLabels.Column(column.Status)</h3>
                            <p>@UiLabels.ColumnHint(column.Status)</p>
                        </div>
                        <span class="column-count" aria-label="Total nesta coluna: @column.Tasks.Count">@column.Tasks.Count</span>
                    </header>

                    <div class="task-list">
                        @if (column.Tasks.Count == 0)
                        {
                            <div class="empty-state">
                                <span aria-hidden="true">✦</span>
                                <p>Nada por aqui.</p>
                                <small>Quando fizer sentido, mova uma atividade para esta etapa.</small>
                            </div>
                        }
                        @foreach (var task in column.Tasks)
                        {
                            var priorityToken = UiLabels.CssToken(task.PriorityLevel);
                            var fitToken = UiLabels.CssToken(task.CapacityFit);
                            <article class="task-card priority-@priorityToken" data-testid="task-card">
                                <div class="task-topline">
                                    <span class="priority-badge">@UiLabels.Priority(task.PriorityLevel) · @task.PriorityScore</span>
                                    <span class="importance-dot importance-@UiLabels.CssToken(task.Importance)">@UiLabels.Importance(task.Importance)</span>
                                </div>
                                <h4>@task.Title</h4>
                                <p class="priority-explanation">@task.PriorityExplanation</p>
                                <dl class="task-meta">
                                    <div>
                                        <dt>Prazo</dt>
                                        <dd class="@(task.DaysUntilDue < 0 && task.Status != KanbanColumn.Completed ? "is-late" : string.Empty)">
                                            @(task.Status == KanbanColumn.Completed
                                                ? $"Entregue · {task.DueDate:dd/MM}"
                                                : UiLabels.Deadline(task.DueDate, task.DaysUntilDue))
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>Esforço</dt>
                                        <dd>@task.EstimatedHours.ToString("0.##") h</dd>
                                    </div>
                                </dl>
                                <div class="fit-state fit-@fitToken">
                                    <span aria-hidden="true"></span>
                                    @UiLabels.Capacity(task.CapacityFit)
                                </div>
                                <div class="card-actions">
                                    <a class="text-action" asp-action="Edit" asp-route-id="@task.Id">Editar</a>
                                    <details class="move-menu">
                                        <summary>Mover</summary>
                                        <div class="move-options">
                                            @foreach (var destination in Enum.GetValues<KanbanColumn>().Where(destination => destination != task.Status))
                                            {
                                                <form asp-action="Move" asp-route-id="@task.Id" method="post">
                                                    <button type="submit" name="status" value="@destination" aria-label="Mover @task.Title para @UiLabels.Column(destination)">
                                                        @UiLabels.Column(destination)
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </details>
                                    <form asp-action="Delete" asp-route-id="@task.Id" method="post" class="delete-form" data-confirm="Excluir “@task.Title”? Esta ação não pode ser desfeita.">
                                        <button type="submit">Excluir</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
</main>
