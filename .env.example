POSTGRES_DB=cabe_na_semana
# Papel administrativo usado somente pelo PostgreSQL e pelo bootstrap.
POSTGRES_USER=cabe_admin
POSTGRES_PASSWORD=substitua-por-uma-senha-local-forte

# Papel sem privilégios administrativos usado pela API.
APP_DB_USER=cabe_runtime
APP_DB_PASSWORD=substitua-por-outra-senha-local-forte

APP_PORT=8080
POSTGRES_PORT=5432
